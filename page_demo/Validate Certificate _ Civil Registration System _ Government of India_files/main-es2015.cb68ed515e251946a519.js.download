2018Haryana\u2019, \u2018Jammu and Kashmir\u2019, \u2018Himachal Pradesh\u2019, \u2018Jharkhand\u2019 , \u2018Manipur\u2019, \'Gujarat\', \'Puducherry\', \'Delhi Cantonment Board\' and \'Goa\' only.","EsignErrT":"Service Unavailable","signatureL":"Dear User, You can choose default signature type in your profile to ease the signature process while approving and registering events.","dashMarqueeTextArr":[{"eText":"The time period of 90 days, available for entering the reported events into the CRS portal by the registrat, shall be reduced to 10 days w.e.f. 15-04-2025 with a view to quicken the process of registration and issue the certificate within 7 days in accordance with the provisions of section 12 of the RBD Act, 1969 (amended in 2023).","hText":"\u0930\u091c\u093f\u0938\u094d\u091f\u094d\u0930\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0940\u0906\u0930\u090f\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u092e\u0947\u0902 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0940 \u0917\u0908 \u0918\u091f\u0928\u093e\u0913\u0902 \u0915\u094b \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 90 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0938\u092e\u092f\u093e\u0935\u0927\u093f \u0915\u094b 15-04-2025 \u0938\u0947 \u0918\u091f\u093e\u0915\u0930 10 \u0926\u093f\u0928 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e, \u0924\u093e\u0915\u093f \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092e\u0947\u0902 \u0924\u0947\u091c\u0940 \u0932\u093e\u0908 \u091c\u093e \u0938\u0915\u0947 \u0914\u0930 \u0906\u0930\u092c\u0940\u0921\u0940 \u0905\u0927\u093f\u0928\u093f\u092f\u092e, 1969 (2023 \u092e\u0947\u0902 \u0938\u0902\u0936\u094b\u0927\u093f\u0924) \u0915\u0940 \u0927\u093e\u0930\u093e 12 \u0915\u0947 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 7 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 \u091c\u093e\u0930\u0940 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0964"}],"dashMarqueeTextOnlyAadhaarConsentForGraceUserArr":[{"eText":"Your profile requires Aadhaar authentication. Please complete the process within {{dayPeriod}} days by navigating to User Management >> View Profile and entering your Aadhaar number. Failure to complete the authentication within the specified period will result in temporary suspension of your account services until verification is successfully completed.","hText":"\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e {{dayPeriod}} \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 User Management >> View Profile \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 \u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0947\u0902\u0964 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0905\u0935\u0927\u093f \u0915\u0947 \u092d\u0940\u0924\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092a\u0942\u0930\u093e \u0928 \u0915\u0930\u0928\u0947 \u092a\u0930, \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u0924\u0915 \u0906\u092a\u0915\u0947 \u0905\u0915\u093e\u0909\u0902\u091f \u0915\u0940 \u0938\u0947\u0935\u093e\u090f\u0901 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u0915\u0930 \u0926\u0940 \u091c\u093e\u090f\u0901\u0917\u0940\u0964"}],"dashMarqueeTextOnlyAadhaarConsentForNonGraceUserArr":[{"eText":"Aadhaar authentication is required to access the full functionality of the CRS Portal. Please complete the authentication process by navigating to User Management >> View Profile and adding your Aadhaar number to proceed.","hText":"\u0938\u0940\u0906\u0930\u090f\u0938 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0940 \u0938\u092d\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0942\u091c\u093c\u0930 \u092e\u0948\u0928\u0947\u091c\u092e\u0947\u0902\u091f >> \u0935\u094d\u092f\u0942 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 \u0905\u092a\u0928\u093e \u0906\u0927\u093e\u0930 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0947\u0902\u0964"}],"GPFlashTextArr":[{"eText":"A General Public user is permitted to submit a maximum of four events in total.","hText":"\u090f\u0915 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u094b \u0915\u0941\u0932 \u092e\u093f\u0932\u093e\u0915\u0930 \u0905\u0927\u093f\u0915\u0924\u092e \u091a\u093e\u0930 \u0907\u0935\u0947\u0902\u091f \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0939\u0948\u0964"}],"maintainenceL":"Portal will not be available due to maintenance activity from 11:30 PM 07-08-2026 to 04:30 AM 08-08-2026","maintainenceLL":"The portal will be unavailable due to scheduled maintenance daily from 17-07-2026 to 19-07-2026, between 12:00 AM and 6:00 AM.","unitUserInactiveMsg":"If no login activity is recorded for a period of 90 days, the respective Registrar/Sub-Registrar of the Registration Unit will be automatically marked as Inactive.","DSCMsg":"Digital Signature Certificate (DSC) has been enabled in the CRS Portal. Users may utilize DSC for the approval process."},"a":{"disableRightClick":true,"disableF12":true,"disableCtrlShiftI":true,"disableCtrlShiftJ":true,"disableCtrlShiftC":true,"disableCtrlU":true}}')},"/pl5":function(e,t,n){"use strict";n.d(t,"a",function(){return o});var r=n("0IaG"),i=n("fXoL"),a=n("tyNb");let o=(()=>{class e{constructor(e,t,n){this.dialogRef=e,this.router=t,this.data=n,this.confirmed=!1,this.message=""}ngOnInit(){this.message=this.data.message}proceed(){this.router.navigate(["/Dashboard/UpdateProfile"]),window.sessionStorage.setItem("isAadhaarConsentSkipped","true"),this.dialogRef.close()}proceedToAadhaarAuth(){this.router.navigate(["/Dashboard/UpdateProfile"]),this.dialogRef.close()}closeDialog(){window.sessionStorage.setItem("isAadhaarConsentSkipped","true"),this.dialogRef.close()}}return e.\u0275fac=function(t){return new(t||e)(i["\u0275\u0275directiveInject"](r.g),i["\u0275\u0275directiveInject"](a.f),i["\u0275\u0275directiveInject"](r.a))},e.\u0275cmp=i["\u0275\u0275defineComponent"]({type:e,selectors:[["aadhaar-consent-popup"]],decls:12,vars:2,consts:[[1,"aadhar-consent-popup"],[3,"innerHTML"],["for","aadhaarConsent",2,"display","inline-block","text-align","justify"],["type","checkbox","id","aadhaarConsent",2,"display","inline-block","margin-right","10px",3,"change"],["mat-raised-button","",1,"mat-raised-button","accent",3,"disabled","click"]],template:function(e,t){1&e&&(i["\u0275\u0275elementStart"](0,"div",0),i["\u0275\u0275elementStart"](1,"h2"),i["\u0275\u0275text"](2,"Aadhaar Authentication Required !!"),i[