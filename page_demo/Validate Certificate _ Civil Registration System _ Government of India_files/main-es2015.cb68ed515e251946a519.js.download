0275\u0275elementStart"](11,"p"),i["\u0275\u0275text"](12,"Information in the website is for the benefit of the users. Material featured on this website if used, has to be reproduced accurately and should not be used in a derogatory manner or in a misleading context. Wherever the material is being published or issued to others, the source must be prominently acknowledged. However, the permission/ authorization to reproduce any material which is identified as being copyright of a third party, must be obtained from the concerned department / copyright holders."),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](13,"p"),i["\u0275\u0275text"](14,"These terms and conditions shall be governed by and construed in accordance with the Indian Laws. Any dispute arising under these terms and conditions shall be subject to the exclusive jurisdiction of the courts of India."),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"]())},directives:[p.a],styles:[""]}),e})(),t_=(()=>{class e{constructor(){}ngOnInit(){}}return e.\u0275fac=function(t){return new(t||e)},e.\u0275cmp=i["\u0275\u0275defineComponent"]({type:e,selectors:[["app-accessibility-statement"]],decls:13,vars:0,consts:[[1,"container","mt-3","mb-4"],[1,"row"],[1,"col"],[1,"border-top","border-4","border-primary","px-4"]],template:function(e,t){1&e&&(i["\u0275\u0275elementStart"](0,"section"),i["\u0275\u0275elementStart"](1,"div",0),i["\u0275\u0275elementStart"](2,"div",1),i["\u0275\u0275elementStart"](3,"div",2),i["\u0275\u0275elementStart"](4,"mat-card",3),i["\u0275\u0275elementStart"](5,"h2"),i["\u0275\u0275text"](6,"ACCESSIBILITY STATEMENT"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](7,"p"),i["\u0275\u0275text"](8,"We are committed to ensure that the ORGI website is accessible to all users irrespective of device in use, technology or ability. It has been built, with an aim, to provide maximum accessibility and usability to its visitors. As a result this portal can be viewed from a variety of devices such as Desktop / Laptop Computers, Web-enabled mobile devices; etc."),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](9,"p"),i["\u0275\u0275text"](10,"We have put in our best efforts to ensure that all information on this portal is accessible easily. We also aim to be standards compliant and follow principles of usability and universal design, which should help all visitors of this portal."),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](11,"p"),i["\u0275\u0275text"](12,"This portal is designed using DRUPAL 8 to meet Web Development Guidelines for Websites and also adheres to level A of the Web Content Accessibility Guidelines (WCAG) 2.0 laid down by the WorldWideWeb Consortium (W3C). If you have any problem or suggestion regarding the accessibility of this portal, please contact us to enable us to respond in a helpful manner. Do let us know the nature of the problem along with your contact information."),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"]())},directives:[p.a],styles:[""]}),e})(),n_=(()=>{class e{constructor(){}ngOnInit(){}}return e.\u0275fac=function(t){return new(t||e)},e.\u0275cmp=i["\u0275\u0275defineComponent"]({type:e,selectors:[["app-web-information-manager"]],decls:30,vars:0,consts:[[1,"container","mt-3","mb-4"],[1,"row"],[1,"col"],[1,"border-top","border-4","border-primary","px-4"],[1,"d-flex","align-items-center"],[1,"flex-1"],[1,"mb-1"],[1,"badge","badge-soft-success","mb-0"],[1,"mt-2","pt-1"],[1,"text-muted","mb-0"],[1,"font-size-16","align-middle","pe-2","text-primary"],[1,"text-muted","mb-0","mt-1"]],template:function(e,t){1&e&&(i["\u0275\u0275elementStart"](0,"section"),i["\u0275\u0275elementStart"](1,"div",0),i["\u0275\u0275elementStart"](2,"div",1),i["