5text"](29,"Sample Registration System, is a survey conducted by Office of Registrar General India, Ministry of Home Affairs, Govt. of India through Government allotted Enumerators and Supervisors only. The information collected in the Apps, will only be used by the Government of India for estimating and analyzing various vital indicators as part of the demographic survey. The identity particulars of the data principal will not be shared with any third-party institutions or organization or private public."),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](30,"h4",4),i["\u0275\u0275text"](31,"For HL and PE Apps"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](32,"ol"),i["\u0275\u0275elementStart"](33,"li",6),i["\u0275\u0275text"](34,"The Census Act, 1948"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](35,"li",6),i["\u0275\u0275text"](36,"The census Rules, 1990"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](37,"p"),i["\u0275\u0275text"](38,"For The above Acts and Rules Click here"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](39,"h4",4),i["\u0275\u0275text"](40,"For NPR App"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](41,"ol"),i["\u0275\u0275elementStart"](42,"li",6),i["\u0275\u0275text"](43,"The Citizenship Act, 1955"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](44,"li",6),i["\u0275\u0275text"](45,"The Citizenship Rules, 2003"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](46,"p"),i["\u0275\u0275text"](47,"For The above Acts and Rules Click here"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](48,"h4",4),i["\u0275\u0275text"](49,"For CRS App"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementStart"](50,"ol"),i["\u0275\u0275elementStart"](51,"li",6),i["\u0275\u0275text"](52,"The Registration of Births and Deaths Act, 1969"),i["\u0275\u0275elementEnd"](),i["\u0275\u0275elementEnd"]