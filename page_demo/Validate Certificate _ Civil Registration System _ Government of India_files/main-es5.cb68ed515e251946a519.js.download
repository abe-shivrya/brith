 personally identifiable information on the ORGI website to any third party (public/private). Any information provided to this website will be protected from loss, misuse, unauthorized access or disclosure, alteration, or destruction."),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementStart"](27,"p"),a["\u0275\u0275text"](28,"We collect certain information about the user, such as Internet Protocol (IP) addresses, domain name, browser type, operating system, date and time of visit and pages visited. We make no effort to link these addresses to the identities of individuals who visit our sites unless there is an attempt to damage the site."),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementEnd"]())},directives:[f.a],styles:[""]}),y_),w_=((b_=function(){function e(){_classCallCheck2(this,e)}return _createClass2(e,[{key:"ngOnInit",value:function(){}}]),e}()).\u0275fac=function(e){return new(e||b_)},b_.\u0275cmp=a["\u0275\u0275defineComponent"]({type:b_,selectors:[["app-mobile-app-policy"]],decls:55,vars:0,consts:[[1,"container","mt-3","mb-4"],[1,"row"],[1,"col"],[1,"border-top","border-4","border-primary","px-4"],[1,"policy-subtitle","mb-2"],[1,"list-bullets"],[1,"mb-2"]],template:function(e,t){1&e&&(a["\u0275\u0275elementStart"](0,"section"),a["\u0275\u0275elementStart"](1,"div",0),a["\u0275\u0275elementStart"](2,"div",1),a["\u0275\u0275elementStart"](3,"div",2),a["\u0275\u0275elementStart"](4,"mat-card",3),a["\u0275\u0275elementStart"](5,"h2"),a["\u0275\u0275text"](6,"Mobile App Privacy Policy"),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementStart"](7,"h4",4),a["\u0275\u0275text"](8,"Privacy Policy for HL, NPR, PE, CRS and SRS Apps"),a["\u0275\u0275elementEnd"](),a["\u0275\u0275elementStart"](9,"ul",5),a["\u0275\u0275elementStart"](10,"li",6),a["\u0275\u0275text"](11,"HL App Name - Census of India 2021- HL (Google play store)"),a["\u0275\u